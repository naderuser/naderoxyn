{
  // اسم Worker: باید دقیقاً همان اسمی باشد که در داشبورد کلودفلر داری
  // (Workers & Pages -> اسم Worker). اگر فرق کند، کلودفلر یک Worker جدید می‌سازد.
  "name": "nadervpnn",

  // فایل اصلی کد در همین ریپازیتوری
  "main": "worker.js",

  "compatibility_date": "2026-03-17",

  // اتصال KV: اسم binding باید دقیقاً KV باشد (کد از env.KV می‌خواند)
  // id را از داشبورد بردار: Storage & Databases -> KV -> namespace -> ID
  // KV را نگه دار: کد داده‌های قبلی را از KV به D1 منتقل می‌کند.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3755f3862e234f50b0d318d3dad40b82"
    }
  ],

  // اتصال D1: اسم binding بهتر است DB باشد (کد از env.DB می‌خواند)
  // database_id را از داشبورد بردار: Storage & Databases -> D1 SQL database -> دیتابیس -> UUID
  // جدول kv خودکار ساخته می‌شود و migration لازم نیست.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naderonyx1",
      "database_id": "3acb7572-c6c2-4e44-a47d-90a140792902"
    }
  ]

  // رمز پنل (ADMIN) را اینجا نگذار، چون ریپازیتوری در دسترس است.
  // آن را فقط در داشبورد بگذار: Settings -> Variables and Secrets -> ADMIN (نوع Secret)
}
